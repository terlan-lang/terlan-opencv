module opencv_consumer.OpenCvConsumerTest.

import opencv_consumer.{CodecChecks, Smoke}.

/**
 * Proves an independent project can execute the generated package through a
 * normal path dependency without compiler-repository source paths.
 */
@test
pub external_consumer_executes_real_opencv_pipeline(): Bool ->
    Smoke.execute().

/**
 * Proves the same independent package path can execute codec operations.
 */
@test
pub external_consumer_executes_real_opencv_codecs(): Bool ->
    CodecChecks.execute().
