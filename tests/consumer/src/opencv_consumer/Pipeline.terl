    let estimated_perspective = Calib3d.estimate_perspective_transform(correspondence_points, translated_points);
    let estimated_perspective_repeated = Calib3d.estimate_perspective_transform(correspondence_points, translated_points);
    let perspective_estimation_valid =
        Calib3d.perspective_transform_points(correspondence_points, estimated_perspective) == translated_points
            and Calib3d.perspective_transform_points(correspondence_points, estimated_perspective_repeated) == translated_points;
    let affine_correspondence_points = [0.0, 0.0, 4.0, 0.0, 0.0, 4.0];
    let affine_translated_points = [2.0, -1.0, 6.0, -1.0, 2.0, 3.0];
    let estimated_affine = Calib3d.estimate_affine_transform(affine_correspondence_points, affine_translated_points);
    let estimated_affine_repeated = Calib3d.estimate_affine_transform(affine_correspondence_points, affine_translated_points);
    let affine_estimation_valid =
