    Mat.dispose(range_mask);
    Mat.dispose(scaled_absolute);
    Mat.dispose(sharpened);
    Mat.dispose(otsu_thresholded);
    Mat.dispose(triangle_thresholded);
    Mat.dispose(otsu_source);
    Mat.dispose(grayscale);
    Mat.dispose(masked);
    Mat.dispose(mask);
    Mat.dispose(weighted);
    Mat.dispose(tiled);
    Mat.dispose(transposed);
    Mat.dispose(transpose_source);
    Mat.dispose(concatenated_vertical);
    Mat.dispose(concatenated_horizontal);
    Mat.dispose(aliased_difference);
    Mat.dispose(absolute_difference);
    Mat.dispose(mean_shifted);
    Mat.dispose(selected_channels);
    Mat.dispose(mask_blended);
    Mat.dispose(blend_weights);
    Mat.dispose(blend_second);
    Mat.dispose(blend_first);
    Mat.dispose(maximum_image);
    Mat.dispose(minimum_image);
    Mat.dispose(divided);
    Mat.dispose(multiplied);
    Mat.dispose(saturated_difference);
    Mat.dispose(saturated_sum);
    Mat.dispose(replaced_red);
    Mat.dispose(merged_bgr);
    Mat.dispose(channel_gradient_magnitude);
    Mat.dispose(channel_equality);
    Mat.dispose(red_channel);
    Mat.dispose(green_channel);
    Mat.dispose(blue_channel);
    Mat.dispose(zero_mat);
    Mat.dispose(mat);
    assert(harris_valid);
    assert(corner_min_eigenvalue_valid);
    assert(pre_corner_response_valid);
    assert(corner_eigensystem_valid);
    assert(circle_detection_valid);
    assert(line_detection_valid);
    assert(
        valid
            and adaptive_equalization_valid
            and mask_selection_valid
            and blend_mask_valid
            and comparison_valid
            and shape_match_valid
            and line_segments_valid
            and draw_line_valid
            and draw_rectangle_valid
            and draw_circle_valid
            and fill_rectangle_valid
            and fill_circle_valid
            and invert_valid
            and bitwise_valid
            and draw_cross_valid
            and ellipse_valid
            and gradient_magnitude_valid
            and distance_transform_valid
            and euclidean_distance_valid
            and flood_fill_valid
            and non_zero_bounds_valid
            and non_zero_centroid_valid
            and non_zero_circle_valid
            and non_zero_triangle_valid
            and fit_line_valid
            and fit_ellipse_valid
            and non_zero_hull_valid
            and approximate_hull_valid
            and non_zero_box_valid
            and multiply_valid
            and divide_valid
            and extrema_valid
            and saturated_arithmetic_valid
            and replace_channel_valid
            and merge_channels_valid
            and extract_channel_valid
            and tile_valid
            and transpose_valid
            and concatenation_valid
            and otsu_valid
            and triangle_valid
            and template_match_valid
            and mean_absolute_error_valid
            and mask_xor_valid
            and channel_sums_valid
            and integral_valid
            and mean_shift_valid
            and sharpen_valid
            and scale_abs_valid
            and lookup_valid
            and sobel_valid
            and scharr_valid
            and box_blur_valid
            and stack_blur_valid
            and adaptive_valid
            and laplacian_valid
            and morphology_valid
            and pyramid_valid
            and Mat.live_count() == 0,
    ).
