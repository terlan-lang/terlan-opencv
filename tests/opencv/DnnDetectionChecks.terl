/**
 * Validates inference-backed normalized SSD detection decoding and cleanup.
 */
dnn_ssd_detections_valid(): Bool ->
    let source =
        Bytes.from_list(
            [
                0,
                0,
                0,
                0,
                255,
                255,
                242,
                204,
                229,
                0,
                51,
                26,
                0,
                51,
                26,
                255,
                153,
                128,
                255,
                153,
                128,
            ],
        );
    let image = Mat.from_u8(source, 1, 7, Atom["bgr"]);
    let blob = Dnn.blob_from_bgr_rgb(image, 7, 1);
    let model = Dnn.load_onnx(ssd_reshape_onnx_bytes());
    let output = Dnn.forward(model, blob);
    let detections = Dnn.ssd_detections(output, 0.5, 3);
    let repeated = Dnn.ssd_detections(output, 0.5, 3);
    let filtered = Dnn.ssd_detections(output, 0.85, 3);
    let suppressed = Dnn.non_max_suppression(detections, 0.3, 3);
    let retained_nms = Dnn.non_max_suppression(detections, 0.5, 3);
    let bounded_nms = Dnn.non_max_suppression(detections, 0.5, 1);
    let confidences = Dnn.detection_confidences(detections);
    let boxes = Dnn.detection_boxes(detections);
    let valid =
        Dnn.output_shape(output) == [1, 1, 3, 7]
            and Dnn.detection_count(detections) == 2
            and Dnn.detection_class_indices(detections) == [1, 1]
            and Dnn.detection_class_indices(repeated) == [1, 1]
            and Dnn.detection_count(filtered) == 1
            and Dnn.detection_class_indices(suppressed) == [1]
            and Dnn.detection_class_indices(retained_nms) == [1, 1]
            and Dnn.detection_class_indices(bounded_nms) == [1]
            and confidences.length() == 2
            and confidences[0] > confidences[1]
            and confidences[0] > 0.89
            and confidences[0] < 0.9
            and boxes.length() == 8
            and boxes[0] > 0.1
            and boxes[0] < 0.11
            and Dnn.live_detection_count() == 6;
    Dnn.dispose_output(output);
    let retained = Dnn.detection_class_indices(detections) == [1, 1];
    (Dnn.dispose_detections(detections); let suppression_retained = Dnn.detection_class_indices(suppressed) == [1];
(Dnn.dispose_detections(bounded_nms); Dnn.dispose_detections(retained_nms); Dnn.dispose_detections(suppressed); Dnn.dispose_detections(filtered); Dnn.dispose_detections(repeated); Dnn.dispose_model(model); Dnn.dispose(blob); Mat.dispose(image); valid
    and retained
    and suppression_retained
    and Dnn.live_detection_count() == 0
    and Dnn.live_model_count() == 0
    and Dnn.live_output_count() == 0
    and Dnn.live_count() == 0)).

/**
 * Validates generic normalized XYXY detection decoding and cleanup.
 */
dnn_xyxy_detections_valid(): Bool ->
    let source =
        Bytes.from_list(
            [179, 51, 26, 179, 51, 26, 229, 153, 102, 229, 153, 102, 102, 229, 204, 0, 255, 0],
        );
    let image = Mat.from_u8(source, 1, 6, Atom["bgr"]);
    let blob = Dnn.blob_from_bgr_rgb(image, 6, 1);
    let model = Dnn.load_onnx(xyxy_reshape_onnx_bytes());
    let output = Dnn.forward(model, blob);
    let detections = Dnn.normalized_xyxy_detections(output, 0.5, 3);
    let repeated = Dnn.normalized_xyxy_detections(output, 0.5, 3);
    let filtered = Dnn.normalized_xyxy_detections(output, 0.85, 3);
    let confidences = Dnn.detection_confidences(detections);
    let boxes = Dnn.detection_boxes(detections);
    let valid =
        Dnn.output_shape(output) == [1, 3, 6]
            and Dnn.detection_class_indices(detections) == [1, 0]
            and Dnn.detection_class_indices(repeated) == [1, 0]
            and Dnn.detection_class_indices(filtered) == [1]
            and confidences.length() == 2
            and confidences[0] > confidences[1]
            and boxes.length() == 8
            and boxes[0] > 0.19
            and boxes[0] < 0.21
            and Dnn.live_detection_count() == 3;
    Dnn.dispose_output(output);
    let retained = Dnn.detection_class_indices(detections) == [1, 0];
    (Dnn.dispose_detections(filtered); Dnn.dispose_detections(repeated); Dnn.dispose_detections(detections); Dnn.dispose_model(model); Dnn.dispose(blob); Mat.dispose(image); valid
    and retained
    and Dnn.live_detection_count() == 0
    and Dnn.live_model_count() == 0
    and Dnn.live_output_count() == 0
    and Dnn.live_count() == 0).

/**
 * Validates normalized center-XYWH conversion into copied XYXY detections.
 */
dnn_center_xywh_detections_valid(): Bool ->
    let source =
        Bytes.from_list(
            [204, 102, 64, 204, 102, 64, 51, 102, 77, 51, 102, 77, 102, 229, 204, 0, 255, 0],
        );
    let image = Mat.from_u8(source, 1, 6, Atom["bgr"]);
    let blob = Dnn.blob_from_bgr_rgb(image, 6, 1);
    let model = Dnn.load_onnx(xyxy_reshape_onnx_bytes());
    let output = Dnn.forward(model, blob);
    let detections = Dnn.normalized_center_xywh_detections(output, 0.5, 3);
    let repeated = Dnn.normalized_center_xywh_detections(output, 0.5, 3);
    let filtered = Dnn.normalized_center_xywh_detections(output, 0.85, 3);
    let boxes = Dnn.detection_boxes(detections);
    let valid =
        Dnn.output_shape(output) == [1, 3, 6]
            and Dnn.detection_class_indices(detections) == [1, 0]
            and Dnn.detection_class_indices(repeated) == [1, 0]
            and Dnn.detection_class_indices(filtered) == [1]
            and boxes.length() == 8
            and boxes[0] > 0.19
            and boxes[0] < 0.21
            and boxes[1] > 0.19
            and boxes[1] < 0.21
            and boxes[2] > 0.59
            and boxes[2] < 0.61
            and boxes[3] > 0.59
            and boxes[3] < 0.61
            and Dnn.live_detection_count() == 3;
    Dnn.dispose_output(output);
    let retained = Dnn.detection_class_indices(detections) == [1, 0];
    (Dnn.dispose_detections(filtered); Dnn.dispose_detections(repeated); Dnn.dispose_detections(detections); Dnn.dispose_model(model); Dnn.dispose(blob); Mat.dispose(image); valid
    and retained
    and Dnn.live_detection_count() == 0
    and Dnn.live_model_count() == 0
    and Dnn.live_output_count() == 0
    and Dnn.live_count() == 0).

