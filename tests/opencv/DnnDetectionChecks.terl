/**
 * Validates field-major objectness decoding into copied detections.
 */
dnn_transposed_objectness_detections_valid(): Bool ->
    let source =
        Bytes.from_list(
            [
                128,
                102,
                64,
                204,
                51,
                102,
                26,
                77,
                204,
                128,
                102,
                64,
                51,
                51,
                102,
                229,
                204,
                204,
                128,
                229,
                77,
            ],
        );
    let image = Mat.from_u8(source, 1, 7, Atom["bgr"]);
    let blob = Dnn.blob_from_bgr_rgb(image, 7, 1);
    let model = Dnn.load_onnx(transposed_objectness_reshape_onnx_bytes());
    let output = Dnn.forward(model, blob);
    let detections = Dnn.normalized_transposed_objectness_detections(output, 0.2, 3);
    let repeated = Dnn.normalized_transposed_objectness_detections(output, 0.2, 3);
