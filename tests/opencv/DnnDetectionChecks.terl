/**
 * Validates variable-class objectness decoding into copied XYXY detections.
 */
dnn_objectness_detections_valid(): Bool ->
    let source =
        Bytes.from_list(
            [
                204,
                102,
                64,
                204,
                102,
                64,
                51,
                102,
                77,
                51,
                102,
                77,
                128,
                229,
                204,
                128,
                26,
                204,
                128,
                229,
                51,
            ],
        );
    let image = Mat.from_u8(source, 1, 7, Atom["bgr"]);
    let blob = Dnn.blob_from_bgr_rgb(image, 7, 1);
    let model = Dnn.load_onnx(objectness_reshape_onnx_bytes());
    let output = Dnn.forward(model, blob);
    let detections = Dnn.normalized_objectness_detections(output, 0.2, 3);
    let repeated = Dnn.normalized_objectness_detections(output, 0.2, 3);
    let filtered = Dnn.normalized_objectness_detections(output, 0.7, 3);
    let confidences = Dnn.detection_confidences(detections);
    let boxes = Dnn.detection_boxes(detections);
    let valid =
        Dnn.output_shape(output) == [1, 3, 7]
            and Dnn.detection_class_indices(detections) == [1, 0, 0]
            and Dnn.detection_class_indices(repeated) == [1, 0, 0]
            and Dnn.detection_class_indices(filtered) == [1]
            and confidences.length() == 3
            and confidences[0] > confidences[1]
            and confidences[1] > confidences[2]
            and boxes.length() == 12
            and boxes[0] > 0.19
            and boxes[0] < 0.21
            and boxes[2] > 0.59
            and boxes[2] < 0.61
            and Dnn.live_detection_count() == 3;
    Dnn.dispose_output(output);
    let retained = Dnn.detection_class_indices(detections) == [1, 0, 0];
    (Dnn.dispose_detections(filtered); Dnn.dispose_detections(repeated); Dnn.dispose_detections(detections); Dnn.dispose_model(model); Dnn.dispose(blob); Mat.dispose(image); valid
    and retained
    and Dnn.live_detection_count() == 0
    and Dnn.live_model_count() == 0
    and Dnn.live_output_count() == 0
    and Dnn.live_count() == 0).

