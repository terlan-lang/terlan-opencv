            and Dnn.detection_class_indices(detections) == [1, 0, 0]
            and Dnn.detection_class_indices(repeated) == [1, 0, 0]
            and Dnn.detection_class_indices(filtered) == [1]
            and confidences.length() == 3
            and confidences[0] > confidences[1]
            and confidences[1] > confidences[2]
            and confidences[0] > 0.8
            and confidences[0] < 0.81
            and boxes.length() == 12
            and boxes[0] > 0.19
            and boxes[0] < 0.21
            and boxes[2] > 0.59
            and boxes[2] < 0.61
            and Dnn.live_detection_count() == 3;
    Dnn.dispose_output(output);
    let retained = Dnn.detection_class_indices(detections) == [1, 0, 0];
    (Dnn.dispose_detections(filtered); Dnn.dispose_detections(repeated); Dnn.dispose_detections(detections); Dnn.dispose_model(model); Dnn.dispose(blob); Mat.dispose(image); valid
    and retained
    and Dnn.live_detection_count() == 0
    and Dnn.live_model_count() == 0
    and Dnn.live_output_count() == 0
    and Dnn.live_count() == 0).

/**
 * Runs every package-local DNN detection projection contract.
 */
pub valid(): Bool ->
    dnn_ssd_detections_valid()
        and dnn_xyxy_detections_valid()
        and dnn_center_xywh_detections_valid()
        and dnn_top_left_xywh_detections_valid()
        and dnn_objectness_detections_valid()
        and dnn_class_score_detections_valid()
        and dnn_transposed_class_score_detections_valid()
        and dnn_transposed_objectness_detections_valid().
