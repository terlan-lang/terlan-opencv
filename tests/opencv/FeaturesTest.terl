module opencv.FeaturesTest.

import opencv.{Features, Mat}.
import std.vm.Bytes.

/**
 * Validates ORB extraction, matching, copied results, and owner cleanup.
 */
@test
pub orb_feature_contracts(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let features = Features.detect_orb(source, 8);
    let extraction_valid =
        Features.count(features) == 0
            and Features.keypoints(features) == []
            and Features.descriptor_width(features) == 32
            and Features.descriptors(features).to_list() == []
            and Features.live_count() == 1;
    let matches = Features.match_orb(features, features, 8);
    let matching_valid =
        Features.match_count(matches) == 0
            and Features.match_indices(matches) == []
            and Features.match_distances(matches) == []
            and Features.match_coordinates(matches) == []
            and Features.live_match_count() == 1;
    Features.dispose_matches(matches);
    Features.dispose(features);
    Mat.dispose(source);
    extraction_valid
        and matching_valid
        and Features.live_match_count() == 0
        and Features.live_count() == 0
        and Mat.live_count() == 0.

/**
 * Validates BRISK extraction, matching, copied results, and owner cleanup.
 */
@test
pub brisk_feature_contracts(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let features = Features.detect_brisk(source, 30, 3, 8);
    let extraction_valid =
        Features.brisk_count(features) == 0
            and Features.brisk_keypoints(features) == []
            and Features.brisk_descriptor_width(features) == 64
            and Features.brisk_descriptors(features).to_list() == []
            and Features.live_brisk_count() == 1;
    let matches = Features.match_brisk(features, features, 8);
    let matching_valid =
        Features.brisk_match_count(matches) == 0
            and Features.brisk_match_indices(matches) == []
            and Features.brisk_match_distances(matches) == []
            and Features.brisk_match_coordinates(matches) == []
            and Features.live_brisk_match_count() == 1;
    Features.dispose_brisk_matches(matches);
    Features.dispose_brisk(features);
    Mat.dispose(source);
    extraction_valid
        and matching_valid
        and Features.live_brisk_match_count() == 0
        and Features.live_brisk_count() == 0
        and Mat.live_count() == 0.

