/**
 * Validates the MSER region count and owner cleanup.
 */
@test
pub mser_count_contract(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let regions = Features.detect_mser(source, 5, 16, 1024, 8);
    let valid = Features.mser_count(regions) == 0 and Features.live_mser_count() == 1;
    Features.dispose_mser(regions);
    Mat.dispose(source);
    valid and Features.live_mser_count() == 0 and Mat.live_count() == 0.

/**
 * Validates MSER point coordinates are copied independently of the owner.
 */
@test
pub mser_points_contract(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let regions = Features.detect_mser(source, 5, 16, 1024, 8);
    let points = Features.mser_points(regions);
    Features.dispose_mser(regions);
    Mat.dispose(source);
    points == [] and Features.live_mser_count() == 0 and Mat.live_count() == 0.

/**
 * Validates MSER region offsets are copied independently of the owner.
 */
@test
pub mser_offsets_contract(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let regions = Features.detect_mser(source, 5, 16, 1024, 8);
    let offsets = Features.mser_offsets(regions);
    Features.dispose_mser(regions);
    Mat.dispose(source);
    offsets == [0] and Features.live_mser_count() == 0 and Mat.live_count() == 0.

/**
 * Validates MSER bounds are copied independently of the owner.
 */
@test
pub mser_bounds_contract(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let regions = Features.detect_mser(source, 5, 16, 1024, 8);
    let bounds = Features.mser_bounds(regions);
    Features.dispose_mser(regions);
    Mat.dispose(source);
    bounds == [] and Features.live_mser_count() == 0 and Mat.live_count() == 0.

/**
 * Validates simple-blob keypoints are returned as copied geometry.
 */
@test
pub blob_feature_contracts(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let keypoints = Features.simple_blob_keypoints(source, 255, 1, 4096, 1.0, 8);
    Mat.dispose(source);
    keypoints == [] and Mat.live_count() == 0.
