/**
 * Validates SIFT and affine-SIFT extraction, matching, and owner cleanup.
 */
@test
pub sift_feature_contracts(): Bool ->
    let source = Mat.zeros(64, 64, Atom["gray"]);
    let features = Features.detect_sift(source, 0.04, 8);
    let extraction_valid =
        Features.sift_count(features) == 0
            and Features.sift_keypoints(features) == []
            and Features.sift_descriptor_width(features) == 128
            and Features.sift_descriptors(features) == []
            and Features.live_sift_count() == 1;
    let affine_features = Features.detect_affine_sift(source, 0.04, 8);
    let affine_valid =
        Features.sift_count(affine_features) == 0
            and Features.sift_keypoints(affine_features) == []
            and Features.sift_descriptor_width(affine_features) == 128
            and Features.sift_descriptors(affine_features) == []
            and Features.live_sift_count() == 2;
    let matches = Features.match_sift(features, features, 8);
    let matching_valid =
        Features.sift_match_count(matches) == 0
            and Features.sift_match_indices(matches) == []
            and Features.sift_match_distances(matches) == []
            and Features.sift_match_coordinates(matches) == []
            and Features.live_sift_match_count() == 1;
    Features.dispose_sift_matches(matches);
    Features.dispose_sift(affine_features);
    Features.dispose_sift(features);
    Mat.dispose(source);
    extraction_valid
        and affine_valid
        and matching_valid
        and Features.live_sift_match_count() == 0
        and Features.live_sift_count() == 0
        and Mat.live_count() == 0.

