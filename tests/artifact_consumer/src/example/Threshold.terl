/**
 * Demonstrates image processing against the installed OpenCV package artifact.
 */
module example.Threshold.

import opencv.Types.{BinaryThreshold, Gray}.
import opencv.{Imgproc, Mat}.
import std.vm.Bytes.

/**
 * Converts four grayscale pixels into one copied binary image.
 */
pub make_binary_image(): Bytes ->
    let image = Mat.from_u8(Bytes.from_list([0, 64, 128, 255]), 2, 2, Gray);
    let binary = Imgproc.threshold(image, 100.0, 255.0, BinaryThreshold);
    let pixels = Mat.to_u8(binary);
    Mat.dispose(binary);
    Mat.dispose(image);
    pixels.
