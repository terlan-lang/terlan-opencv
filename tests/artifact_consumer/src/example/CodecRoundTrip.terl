/**
 * Exercises copied-byte codecs from an installed OpenCV package artifact.
 */
module example.CodecRoundTrip.

import opencv.Types.{Gray, Grayscale, Jpeg, Png, Tiff, Webp}.
import opencv.{Codecs, Mat}.
import std.vm.Bytes.

/**
 * Round-trips a uniform image through the packaged PNG and JPEG codecs.
 */
pub round_trip(): Bool ->
    let source = Mat.from_u8(Bytes.from_list([64, 64, 64, 64]), 2, 2, Gray);
    let png = Codecs.encode(source, Png);
    let jpeg = Codecs.encode(source, Jpeg);
    let webp = Codecs.encode(source, Webp);
    let tiff = Codecs.encode(source, Tiff);
    let decoded_png = Codecs.decode(png, Grayscale);
    let decoded_jpeg = Codecs.decode(jpeg, Grayscale);
    let decoded_webp = Codecs.decode(webp, Grayscale);
    let decoded_tiff = Codecs.decode(tiff, Grayscale);
    let expected = [64, 64, 64, 64];
    let valid =
        Mat.to_u8(decoded_png).to_list() == expected
            and Mat.to_u8(decoded_jpeg).to_list() == expected
            and Mat.rows(decoded_webp) == 2
            and Mat.cols(decoded_webp) == 2
            and Mat.to_u8(decoded_tiff).to_list() == expected;
    Mat.dispose(decoded_tiff);
    Mat.dispose(decoded_webp);
    Mat.dispose(decoded_jpeg);
    Mat.dispose(decoded_png);
    Mat.dispose(source);
    valid and Mat.live_count() == 0.
