# Reproducible package build policy for the pinned OpenCV source checkout.
set(BUILD_LIST "core,imgproc,imgcodecs,features2d,calib3d,ml,dnn" CACHE STRING "OpenCV modules required by terlan-opencv" FORCE)
set(BUILD_SHARED_LIBS ON CACHE BOOL "Build shared OpenCV libraries for package adapters" FORCE)
set(CMAKE_INSTALL_RPATH "$ORIGIN" CACHE STRING "Resolve installed OpenCV libraries beside one another" FORCE)
set(CMAKE_INSTALL_RPATH_USE_LINK_PATH OFF CACHE BOOL "Exclude host library paths from installed runtime metadata" FORCE)
set(BUILD_ZLIB ON CACHE BOOL "Build the package-owned zlib dependency" FORCE)
set(BUILD_JPEG ON CACHE BOOL "Build the package-owned JPEG dependency" FORCE)
set(BUILD_PNG ON CACHE BOOL "Build the package-owned PNG dependency" FORCE)
set(BUILD_WEBP ON CACHE BOOL "Build the package-owned WebP dependency" FORCE)
set(BUILD_TIFF ON CACHE BOOL "Build the package-owned TIFF dependency" FORCE)
set(WITH_WEBP ON CACHE BOOL "Include the reviewed WebP codec" FORCE)
set(WITH_TIFF ON CACHE BOOL "Include the reviewed TIFF codec" FORCE)
set(WITH_OPENJPEG OFF CACHE BOOL "Exclude JPEG 2000 from the base artifact" FORCE)
set(WITH_JASPER OFF CACHE BOOL "Exclude legacy JPEG 2000 from the base artifact" FORCE)
set(WITH_OPENEXR OFF CACHE BOOL "Exclude OpenEXR from the base artifact" FORCE)
set(WITH_JPEGXL OFF CACHE BOOL "Exclude JPEG XL from the base artifact" FORCE)
set(WITH_AVIF OFF CACHE BOOL "Exclude AVIF from the base artifact" FORCE)
set(BUILD_TESTS OFF CACHE BOOL "Disable OpenCV tests in package builds" FORCE)
set(BUILD_PERF_TESTS OFF CACHE BOOL "Disable OpenCV performance tests" FORCE)
set(BUILD_EXAMPLES OFF CACHE BOOL "Disable OpenCV examples" FORCE)
set(BUILD_opencv_apps OFF CACHE BOOL "Disable OpenCV command-line applications" FORCE)
set(BUILD_opencv_gapi OFF CACHE BOOL "Disable G-API and its downloaded ADE dependency" FORCE)
set(WITH_ADE OFF CACHE BOOL "Disable the G-API ADE dependency probe" FORCE)
set(BUILD_JAVA OFF CACHE BOOL "Disable Java bindings" FORCE)
set(BUILD_opencv_python2 OFF CACHE BOOL "Disable Python 2 bindings" FORCE)
set(BUILD_opencv_python3 OFF CACHE BOOL "Disable Python 3 bindings" FORCE)
set(BUILD_opencv_js OFF CACHE BOOL "Disable JavaScript bindings" FORCE)
set(BUILD_DOCS OFF CACHE BOOL "Disable OpenCV documentation build" FORCE)
set(BUILD_WITH_DEBUG_INFO OFF CACHE BOOL "Disable debug metadata in the package build" FORCE)
set(WITH_CUDA OFF CACHE BOOL "Disable CUDA" FORCE)
set(WITH_OPENCL OFF CACHE BOOL "Disable OpenCL" FORCE)
set(WITH_OPENCLAMDBLAS OFF CACHE BOOL "Disable OpenCL BLAS" FORCE)
set(WITH_OPENCLAMDFFT OFF CACHE BOOL "Disable OpenCL FFT" FORCE)
set(WITH_FFMPEG OFF CACHE BOOL "Disable video codecs" FORCE)
set(WITH_GSTREAMER OFF CACHE BOOL "Disable media pipelines" FORCE)
set(WITH_V4L OFF CACHE BOOL "Disable camera capture" FORCE)
set(WITH_GTK OFF CACHE BOOL "Disable GUI integration" FORCE)
set(WITH_QT OFF CACHE BOOL "Disable Qt integration" FORCE)
set(WITH_IPP OFF CACHE BOOL "Disable downloaded Intel IPP artifacts" FORCE)
set(WITH_TBB OFF CACHE BOOL "Disable external task runtime" FORCE)
set(WITH_OPENMP OFF CACHE BOOL "Disable external OpenMP runtime" FORCE)
set(CMAKE_CXX_STANDARD 14 CACHE STRING "C++ standard used by the generated bridge" FORCE)
set(CMAKE_CXX_STANDARD_REQUIRED ON CACHE BOOL "Require the selected C++ standard" FORCE)
set(CMAKE_CXX_EXTENSIONS OFF CACHE BOOL "Use portable C++ mode" FORCE)
