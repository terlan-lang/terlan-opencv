/**
 * Demonstrates deterministic in-memory image encoding and decoding.
 */
module samples.imgcodecs.EncodeDecode.

import opencv.Types.{Bmp, Gray, Grayscale}.
import opencv.{Codecs, Mat}.
import std.collections.List.{length}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the in-memory codec example.
 */
pub main(): Unit ->
    let source = Mat.from_u8(Bytes.from_list([0, 64, 128, 255]), 2, 2, Gray);
    let encoded = Codecs.encode(source, Bmp);
    let decoded = Codecs.decode(encoded, Grayscale);
    let valid = encoded.length() > 0 and Mat.to_u8(decoded).to_list() == [0, 64, 128, 255];
    Mat.dispose(decoded);
    Mat.dispose(source);
    if {
        valid and Mat.live_count() == 0 -> println("codec example complete");
        true -> println("codec example failed")
    }.
