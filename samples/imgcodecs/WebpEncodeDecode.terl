/**
 * Demonstrates deterministic bounded-quality WebP encoding and decoding.
 */
module samples.imgcodecs.WebpEncodeDecode.

import opencv.Types.{Gray, Grayscale, Webp}.
import opencv.{Codecs, Mat}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the in-memory WebP codec example.
 */
pub main(): Unit ->
    let source = Mat.from_u8(Bytes.from_list([64, 64, 64, 64]), 2, 2, Gray);
    let encoded = Codecs.encode(source, Webp);
    let repeated = Codecs.encode(source, Webp);
    let decoded = Codecs.decode(encoded, Grayscale);
    let valid =
        encoded.to_list() == repeated.to_list()
            and Mat.rows(decoded) == 2
            and Mat.cols(decoded) == 2;
    Mat.dispose(decoded);
    Mat.dispose(source);
    if {
        valid and Mat.live_count() == 0 -> println("WebP codec example complete");
        true -> println("WebP codec example failed")
    }.
