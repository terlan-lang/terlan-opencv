/**
 * Demonstrates bounded ORB feature extraction and descriptor inspection.
 */
module samples.features2d.OrbFeatures.

import opencv.Types.{Gray}.
import opencv.{Features, Mat}.
import std.collections.List.{length}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the ORB feature example.
 */
pub main(): Unit ->
    let image = Mat.zeros(64, 64, Gray);
    let features = Features.detect_orb(image, 64);
    let valid =
        Features.count(features) == 0
            and Features.descriptor_width(features) == 32
            and Features.descriptors(features).length() == 0;
    Features.dispose(features);
    Mat.dispose(image);
    if {
        valid and Features.live_count() == 0 and Mat.live_count() == 0 -> println("ORB example complete");
        true -> println("ORB example failed")
    }.
