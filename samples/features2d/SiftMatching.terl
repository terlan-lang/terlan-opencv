/**
 * Demonstrates bounded SIFT detection, float descriptors, and matching.
 */
module samples.features2d.SiftMatching.

import opencv.Types.{Gray}.
import opencv.{Features, Imgproc, Mat}.
import std.io.Console.{println}.

/**
 * Runs the SIFT matching example.
 */
pub main(): Unit ->
    let blank = Mat.zeros(64, 64, Gray);
    let box = Imgproc.draw_rectangle(blank, 8, 8, 48, 48, 255, 2);
    let cross = Imgproc.draw_cross(box, 32, 32, 21, 255, 2);
    let image = Imgproc.draw_circle(cross, 20, 20, 6, 255, 2);
    let query = Features.detect_sift(image, 0.01, 64);
    let train = Features.detect_sift(image, 0.01, 64);
    let matches = Features.match_sift(query, train, 32);
    let match_count = Features.sift_match_count(matches);
    let valid =
        Features.sift_count(query) > 0
            and Features.sift_descriptor_width(query) == 128
            and match_count > 0
            and Features.sift_match_distances(matches)[0] < 0.001;
    Features.dispose_sift_matches(matches);
    Features.dispose_sift(train);
    Features.dispose_sift(query);
    Mat.dispose(image);
    Mat.dispose(cross);
    Mat.dispose(box);
    Mat.dispose(blank);
    if {
        valid
            and Features.live_sift_match_count() == 0
            and Features.live_sift_count() == 0
            and Mat.live_count() == 0 -> println("SIFT matching example complete");
        true -> println("SIFT matching example failed")
    }.
