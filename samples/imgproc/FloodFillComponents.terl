/**
 * Demonstrates flood filling and connected-component analysis.
 */
module samples.imgproc.FloodFillComponents.

import opencv.Types.{Eight, Four, Gray}.
import opencv.{Components, Imgproc, Mat}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the flood-fill and component-labeling example.
 */
pub main(): Unit ->
    let source = Mat.from_u8(Bytes.from_list([0, 255, 0, 0, 255, 0, 0, 0, 255]), 3, 3, Gray);
    let filled = Imgproc.flood_fill(source, 1, 0, 128, Eight);
    let components = Imgproc.connected_components(source, Four);
    let valid =
        Mat.to_u8(filled).to_list() == [0, 128, 0, 0, 128, 0, 0, 0, 128]
            and Components.foreground_count(components) == 2
            and Components.areas(components) == [2, 1];
    Components.dispose(components);
    Mat.dispose(filled);
    Mat.dispose(source);
    if {
        valid and Components.live_count() == 0 and Mat.live_count() == 0 -> println("Flood fill and components example complete");
        true -> println("Flood fill and components example failed")
    }.
