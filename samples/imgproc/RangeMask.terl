/**
 * Demonstrates selecting pixels that fall inside a bounded value range.
 */
module samples.imgproc.RangeMask.

import opencv.Types.{Gray}.
import opencv.{Imgproc, Mat}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the range-mask example.
 */
pub main(): Unit ->
    let image = Mat.from_u8(Bytes.from_list([0, 64, 127, 200]), 2, 2, Gray);
    let mask = Imgproc.in_range(image, 60, 150);
    let valid = Mat.to_u8(mask).to_list() == [0, 255, 255, 0];
    Mat.dispose(mask);
    Mat.dispose(image);
    if {
        valid and Mat.live_count() == 0 -> println("Range mask example complete");
        true -> println("Range mask example failed")
    }.
