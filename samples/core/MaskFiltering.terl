/**
 * Demonstrates a reviewed sharpening mask without direct pixel pointers.
 */
module samples.core.MaskFiltering.

import opencv.Types.{Gray}.
import opencv.{Imgproc, Mat}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the image-mask filtering example.
 */
pub main(): Unit ->
    let image = Mat.from_u8(Bytes.from_list([0, 32, 0, 32, 255, 32, 0, 32, 0]), 3, 3, Gray);
    let sharpened = Imgproc.sharpen(image, 1.0);
    let adjusted = Imgproc.scale_abs(sharpened, 1.0, 0.0);
    let valid = Mat.rows(adjusted) == 3 and Mat.cols(adjusted) == 3;
    Mat.dispose(adjusted);
    Mat.dispose(sharpened);
    Mat.dispose(image);
    if {
        valid and Mat.live_count() == 0 -> println("Mask filtering example complete");
        true -> println("Mask filtering example failed")
    }.
