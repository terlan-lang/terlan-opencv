                8,
                7,
                66,
                2,
                16,
                13,
            ],
        );
    let image =
        Mat.from_u8(
            Bytes.from_list(
                [
                    0,
                    0,
                    0,
                    0,
                    255,
                    255,
                    242,
                    204,
                    229,
                    0,
                    51,
                    26,
                    0,
                    51,
                    26,
                    255,
                    153,
                    128,
                    255,
                    153,
                    128,
                ],
            ),
            1,
            7,
            Bgr,
        );
    let blob = Dnn.blob_from_bgr_rgb(image, 7, 1);
    let model = Dnn.load_onnx(model_bytes);
    let output = Dnn.forward(model, blob);
    let detections = Dnn.ssd_detections(output, 0.5, 3);
    let retained = Dnn.non_max_suppression(detections, 0.3, 3);
    let confidences = Dnn.detection_confidences(detections);
    let valid =
        Dnn.detection_class_indices(detections) == [1, 1]
            and Dnn.detection_count(retained) == 1
            and confidences.length() == 2
            and confidences[0] > confidences[1];
    Dnn.dispose_detections(retained);
    Dnn.dispose_detections(detections);
    Dnn.dispose_output(output);
    Dnn.dispose_model(model);
    Dnn.dispose(blob);
    Mat.dispose(image);
    if {
        valid
            and Dnn.live_detection_count() == 0
            and Dnn.live_output_count() == 0
            and Dnn.live_model_count() == 0
            and Dnn.live_count() == 0
            and Mat.live_count() == 0 -> println("DNN object detection example complete");
        true -> println("DNN object detection example failed")
    }.
