/**
 * Demonstrates normalized SSD decoding and class-aware suppression.
 */
module samples.dnn.ObjectDetection.

import opencv.Types.{Bgr}.
import opencv.{Dnn, Mat}.
import std.collections.List.{length}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the bounded object-detection example.
 */
pub main(): Unit ->
    let model_bytes =
        Bytes.from_list(
            [
                8,
                8,
                18,
                18,
                116,
                101,
                114,
                108,
                97,
                110,
                45,
