/**
 * Demonstrates projecting channel scores into copied segmentation masks.
 */
module samples.dnn.Segmentation.

import opencv.Types.{Bgr}.
import opencv.{Dnn, Mat}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the segmentation projection example.
 */
pub main(): Unit ->
    let model_bytes =
        Bytes.from_list(
            [
                8,
                8,
                18,
                18,
                116,
                101,
                114,
                108,
                97,
                110,
                45,
                111,
                112,
                101,
                110,
                99,
                118,
                45,
                116,
                101,
                115,
                116,
                58,
                120,
                10,
                35,
                10,
                5,
                105,
                110,
                112,
                117,
                116,
                18,
                6,
                111,
                117,
                116,
                112,
                117,
                116,
                26,
                8,
                105,
                100,
                101,
                110,
                116,
                105,
                116,
                121,
                34,
                8,
                73,
                100,
                101,
                110,
                116,
                105,
                116,
                121,
                18,
                14,
                105,
                100,
                101,
                110,
                116,
                105,
                116,
                121,
                95,
                103,
                114,
                97,
                112,
                104,
                90,
                31,
                10,
                5,
                105,
                110,
                112,
                117,
                116,
                18,
                22,
                10,
                20,
                8,
                1,
                18,
                16,
                10,
                2,
                8,
                1,
                10,
                2,
                8,
                3,
                10,
                2,
                8,
                2,
                10,
                2,
                8,
                2,
                98,
                32,
                10,
                6,
                111,
                117,
                116,
                112,
                117,
                116,
                18,
                22,
                10,
                20,
                8,
                1,
                18,
                16,
                10,
                2,
                8,
                1,
                10,
                2,
                8,
                3,
                10,
                2,
                8,
                2,
                10,
                2,
                8,
                2,
                66,
                2,
                16,
                13,
            ],
        );
    let image = Mat.from_u8(Bytes.from_list([0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255]), 2, 2, Bgr);
    let blob = Dnn.blob_from_bgr_rgb(image, 2, 2);
    let model = Dnn.load_onnx(model_bytes);
    let output = Dnn.forward(model, blob);
    let green = Dnn.channel_mask(output, 1, 0.5);
    let classes = Dnn.class_index_mask(output);
    let valid =
        Mat.to_u8(green).to_list() == [0, 255, 0, 255]
            and Mat.to_u8(classes).to_list() == [0, 1, 2, 0];
    Mat.dispose(classes);
    Mat.dispose(green);
    Dnn.dispose_output(output);
    Dnn.dispose_model(model);
    Dnn.dispose(blob);
    Mat.dispose(image);
    if {
        valid
            and Dnn.live_output_count() == 0
            and Dnn.live_model_count() == 0
            and Dnn.live_count() == 0
            and Mat.live_count() == 0 -> println("DNN segmentation example complete");
        true -> println("DNN segmentation example failed")
    }.
