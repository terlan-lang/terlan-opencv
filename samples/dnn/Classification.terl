/**
 * Demonstrates bounded classification from a fixed-shape ONNX output.
 */
module samples.dnn.Classification.

import opencv.Types.{Bgr}.
import opencv.{Dnn, Mat}.
import std.collections.List.{length}.
import std.io.Console.{println}.
import std.vm.Bytes.

/**
 * Runs the classification example.
 */
pub main(): Unit ->
    let model_bytes =
        Bytes.from_list(
            [
                8,
                8,
                18,
                18,
                116,
                101,
                114,
                108,
                97,
                110,
                45,
                111,
                112,
                101,
                110,
                99,
                118,
                45,
                116,
                101,
                115,
                116,
                58,
                109,
                10,
                33,
                10,
                5,
                105,
                110,
                112,
                117,
                116,
                18,
                6,
                111,
                117,
                116,
                112,
                117,
                116,
                26,
                7,
                102,
                108,
                97,
                116,
                116,
                101,
                110,
                34,
                7,
                70,
                108,
                97,
                116,
                116,
                101,
                110,
                18,
                13,
                102,
                108,
                97,
                116,
                116,
                101,
                110,
                95,
                103,
                114,
                97,
                112,
                104,
                90,
                31,
                10,
                5,
                105,
                110,
                112,
                117,
                116,
                18,
                22,
                10,
                20,
                8,
                1,
                18,
                16,
                10,
                2,
                8,
                1,
                10,
                2,
                8,
                3,
                10,
                2,
                8,
                2,
                10,
                2,
                8,
                2,
                98,
                24,
                10,
                6,
                111,
                117,
                116,
                112,
                117,
                116,
                18,
                14,
                10,
                12,
                8,
                1,
                18,
                8,
                10,
                2,
                8,
                1,
                10,
                2,
                8,
                12,
                66,
                2,
                16,
                13,
            ],
        );
    let image = Mat.from_u8(Bytes.from_list([0, 0, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0]), 2, 2, Bgr);
    let blob = Dnn.blob_from_bgr_rgb(image, 2, 2);
    let model = Dnn.load_onnx(model_bytes);
    let output = Dnn.forward(model, blob);
    let classes = Dnn.softmax_classifications(output, 3);
    let scores = Dnn.top_classification_scores(classes);
    let valid =
        Dnn.output_shape(output) == [1, 12]
            and Dnn.top_classification_indices(classes) == [5, 0, 1]
            and scores.length() == 3
            and scores[0] > 0.198
            and scores[0] < 0.199;
    Dnn.dispose_classifications(classes);
    Dnn.dispose_output(output);
    Dnn.dispose_model(model);
    Dnn.dispose(blob);
    Mat.dispose(image);
    if {
        valid
            and Dnn.live_classifications_count() == 0
            and Dnn.live_output_count() == 0
            and Dnn.live_model_count() == 0
            and Dnn.live_count() == 0
            and Mat.live_count() == 0 -> println("DNN classification example complete");
        true -> println("DNN classification example failed")
    }.
